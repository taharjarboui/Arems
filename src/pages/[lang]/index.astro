---
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, contactUrl, langPaths } from '../../i18n/utils';
import { homeAlternates } from '../../lib/content';

// Accueil provisoire (phase 0). Les sections (météo, biodiversité, actions, sentiers,
// partenaires) arrivent en phase 3.

export function getStaticPaths() {
  return langPaths();
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} title={t('site.name')} description={t('hero.text')} alternates={homeAlternates()}>
  <section class="container-x pt-16 pb-24 md:pt-24">
    <h1 class="max-w-3xl text-5xl leading-[1.02] md:text-7xl">{t('hero.title')}</h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-encre/80">{t('hero.text')}</p>
    <div class="mt-8">
      <a href={contactUrl(lang)} class="btn-primary">{t('hero.cta')}</a>
    </div>
  </section>
</Base>
