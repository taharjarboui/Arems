---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EspeceFiche from '../../../components/fiches/EspeceFiche.astro';
import SiteFiche from '../../../components/fiches/SiteFiche.astro';
import SentierFiche from '../../../components/fiches/SentierFiche.astro';
import ActionFiche from '../../../components/fiches/ActionFiche.astro';
import { publishedLangs, sections, type Lang, type SectionKey } from '../../../i18n/ui';
import { splitId, useTranslations, sectionUrl, homeUrl } from '../../../i18n/utils';
import { ficheAlternates, geoFor, bySlug } from '../../../lib/content';
import * as ld from '../../../lib/jsonld';

// Une page par fiche : /fr/biodiversite/flamant-rose, /fr/sentiers/circuit-oued-soud…
// Seules les fiches des langues publiées sont générées.

export async function getStaticPaths() {
  const paths = [];
  for (const key of Object.keys(sections) as SectionKey[]) {
    for (const entry of await getCollection(sections[key].collection)) {
      const { lang, slug } = splitId(entry.id);
      if (publishedLangs.includes(lang)) paths.push({ params: { lang, section: sections[key].path[lang], slug }, props: { key, entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { key, entry } = Astro.props as { key: SectionKey; entry: any };
const slug = splitId(entry.id).slug;
const alternates = await ficheAlternates(key, slug);
const t = useTranslations(lang);
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site);

// Données structurées : la fiche elle-même + son fil d'Ariane.
const fiche =
  key === 'biodiversite' ? ld.espece(entry, url, site)
  : key === 'sites' || key === 'sentiers' ? ld.lieu(entry, url, site, await geoFor(key, slug))
  : ld.action(entry, url, site, entry.data.site ? (await bySlug('sites', lang)).get(entry.data.site)?.data.title : undefined);
const jsonLd = [
  ...(fiche ? [fiche] : []),
  ld.ariane(site, [[t('site.name'), homeUrl(lang)], [t(`section.${key}.title`), sectionUrl(lang, key)], [entry.data.title, Astro.url.pathname]]),
];
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary} image={entry.data.image} alternates={alternates} jsonLd={jsonLd} ogType="article">
  {key === 'biodiversite' && <EspeceFiche entry={entry} lang={lang} />}
  {key === 'sites' && <SiteFiche entry={entry} lang={lang} />}
  {key === 'sentiers' && <SentierFiche entry={entry} lang={lang} />}
  {key === 'actions' && <ActionFiche entry={entry} lang={lang} />}
</Base>
