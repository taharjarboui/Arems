---
import { render, type CollectionEntry } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import Facts from '../Facts.astro';
import Gallery from '../Gallery.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, sectionUrl, formatDate } from '../../i18n/utils';
import { bySlug } from '../../lib/content';
import { srcset, sizes } from '../../lib/images';

interface Props { entry: CollectionEntry<'actions'>; lang: Lang }
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const { Content } = await render(entry);
const site = d.site ? (await bySlug('sites', lang)).get(d.site) : undefined;
---
<PageHeader title={d.title} intro={d.summary} backHref={sectionUrl(lang, 'actions')} backLabel={t('section.actions.title')} />

<div class="container-x grid gap-10 pb-12 md:grid-cols-[minmax(0,1fr)_320px]">
  <div class="min-w-0 space-y-8">
    {d.image && (
      <figure class="mx-0 mt-0">
        <img src={d.image} srcset={srcset(d.image)} sizes={sizes.colonne} fetchpriority="high" alt={d.imageAlt ?? d.title} width="1600" height="1067" class="w-full rounded object-cover" />
        {d.imageCredit && <figcaption class="mt-2 text-xs text-encre/75">{t('espece.photo')} : {d.imageCredit}</figcaption>}
      </figure>
    )}
    <div class="prose-arems max-w-prose"><Content /></div>
    {d.galerie.length > 0 && (
      <section aria-labelledby="photos">
        <h2 id="photos" class="mb-4 text-2xl">{t('action.galerie')}</h2>
        <Gallery images={d.galerie} openLabel={t('galerie.agrandir')} closeLabel={t('galerie.fermer')} />
      </section>
    )}
  </div>
  <aside class="space-y-6">
    <Facts items={[
      { label: t('action.date'), value: d.date && formatDate(d.date, lang) },
      { label: t('action.lieu'), value: d.lieu },
      { label: t('action.site'), value: site?.data.title },
    ]} />
  </aside>
</div>
