---
import { languages, publishedLangs, type Lang } from '../i18n/ui';
import { useTranslations, homeUrl, contactUrl, sectionUrl, pageUrl } from '../i18n/utils';
import { association } from '../config/association';

interface Props { lang: Lang; alternates?: Partial<Record<Lang, string>> }
const { lang, alternates = {} } = Astro.props;
const t = useTranslations(lang);

// `match` : préfixes d'URL qui rendent l'entrée active (« Sites & sentiers » couvre aussi les fiches sentier).
const nav: { href: string; label: string; match: string[] }[] = [
  { href: sectionUrl(lang, 'biodiversite'), label: t('nav.biodiversite'), match: [sectionUrl(lang, 'biodiversite')] },
  { href: sectionUrl(lang, 'sites'), label: t('nav.sites'), match: [sectionUrl(lang, 'sites'), sectionUrl(lang, 'sentiers')] },
  { href: sectionUrl(lang, 'actions'), label: t('nav.actions'), match: [sectionUrl(lang, 'actions')] },
  { href: pageUrl(lang, 'association'), label: t('nav.association'), match: [pageUrl(lang, 'association')] },
  { href: contactUrl(lang), label: t('contact.title'), match: [contactUrl(lang)] },
];
const current = Astro.url.pathname;
const isActive = (match: string[]) => match.some((m) => current === m || current.startsWith(`${m}/`));
---
<header class="border-b border-bordure bg-fond">
  <div class="container-x flex items-center justify-between gap-6 py-4">
    <a href={homeUrl(lang)} class="flex items-center gap-3 shrink-0">
      <img src="/images/logo.png" alt="" width="579" height="366" class="h-12 w-auto" />
      <span class="leading-tight">
        <span class="block font-display text-lg text-primaire">{association.sigle}</span>
        <span class="hidden text-xs text-encre/70 lg:block">{t('site.tagline')}</span>
      </span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden md:block" aria-label={t('nav.main')}>
        <ul class="flex items-center gap-6">
          {nav.map(({ href, label, match }) => {
            const active = isActive(match);
            return (
              <li>
                <a href={href}
                   class:list={['border-b-2 py-1 font-medium', active ? 'border-primaire text-primaire' : 'border-transparent hover:border-bordure']}
                   aria-current={active ? 'page' : undefined}>{label}</a>
              </li>
            );
          })}
        </ul>
      </nav>

      {publishedLangs.length > 1 && (
        <nav aria-label={t('nav.lang')}>
          <ul class="flex items-center gap-3 text-sm">
            {publishedLangs.map((l) => (
              <li>
                <a href={alternates[l] ?? homeUrl(l)}
                   hreflang={l}
                   lang={l}
                   class:list={[l === lang ? 'font-semibold text-primaire' : 'text-encre/70 hover:text-primaire']}
                   aria-current={l === lang ? 'true' : undefined}>{languages[l]}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <button id="menu-toggle" class="md:hidden p-2" aria-expanded="false" aria-controls="menu-mobile" aria-label={t('nav.menu')}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="menu-mobile" class="md:hidden hidden border-t border-bordure bg-fond-alt" aria-label={t('nav.main')}>
    <ul class="container-x py-2">
      {nav.map(({ href, label }) => (
        <li><a href={href} class="block py-3 font-medium">{label}</a></li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
