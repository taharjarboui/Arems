---
interface Props { title: string; text?: string; linkHref?: string; linkLabel?: string; light?: boolean }
const { title, text, linkHref, linkLabel, light = false } = Astro.props;
---
<div class="flex flex-wrap items-end justify-between gap-4">
  <div class="max-w-2xl">
    <h2 class:list={['text-4xl md:text-5xl', light && 'text-chaux']}>{title}</h2>
    {text && <p class:list={['mt-3 text-lg leading-relaxed', light ? 'text-chaux/80' : 'text-mer-900/75']}>{text}</p>}
  </div>
  {linkHref && <a href={linkHref} class:list={['font-semibold underline-offset-4 hover:underline', light ? 'text-soleil-500' : 'text-mer-700']}>{linkLabel}</a>}
</div>
