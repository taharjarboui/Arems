---
/** Carte d'une fiche (lieu, expérience, événement) : photo en arc, catégorie, titre, résumé. */
interface Props {
  href: string;
  title: string;
  summary: string;
  image?: string;
  imageAlt?: string;
  meta?: string;       // catégorie, date…
  cta: string;
}
const { href, title, summary, image, imageAlt = '', meta, cta } = Astro.props;
---
<article class="group flex flex-col">
  <a href={href} class="arch-sm block aspect-[4/3] bg-sable-100" tabindex="-1" aria-hidden="true">
    {image
      ? <img src={image} alt={imageAlt} loading="lazy" width="800" height="600" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      : <div class="h-full w-full bg-[radial-gradient(circle_at_30%_30%,var(--color-sable-300),var(--color-sable-500))]"></div>}
  </a>
  {meta && <p class="mt-4 text-sm font-medium text-mer-700">{meta}</p>}
  <h3 class="mt-1 text-2xl leading-tight"><a href={href} class="hover:text-mer-700">{title}</a></h3>
  <p class="mt-2 text-mer-900/75 leading-relaxed line-clamp-3">{summary}</p>
  <a href={href} class="mt-3 font-semibold text-mer-700 underline-offset-4 hover:underline">{cta}</a>
</article>
