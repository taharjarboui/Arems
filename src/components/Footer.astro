---
import type { Lang } from '../i18n/ui';
import { useTranslations, contactUrl } from '../i18n/utils';
import { association } from '../config/association';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
// Partenaires (collection `partenaires`) et réseaux sociaux ajoutés en phase 1.
---
<footer class="mt-24 bg-mer-900 text-chaux">
  <div class="h-3 bg-soleil-500"></div>
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr]">
    <div>
      <img src="/images/logo.png" alt={association.sigle} width="579" height="366" class="h-16 w-auto rounded-xl" />
      <h2 class="mt-5 text-xl">{t('footer.about')}</h2>
      <p class="mt-2 max-w-md text-chaux/80 leading-relaxed">{association.nom}</p>
      <p class="mt-1 max-w-md text-chaux/80 leading-relaxed" lang="ar" dir="rtl">{association.nomAr}</p>
    </div>
    <div>
      <h2 class="text-xl">{t('footer.contact')}</h2>
      <ul class="mt-3 space-y-2 text-chaux/80">
        <li><a class="hover:text-soleil-500" href={contactUrl(lang)}>{t('contact.title')}</a></li>
        {association.reseaux.map((r) => <li><a class="hover:text-soleil-500" href={r.url} rel="noopener">{r.nom}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-chaux/10">
    <p class="container-x py-5 text-sm text-chaux/60">© {year} {association.sigle}. {t('footer.rights')}</p>
  </div>
</footer>
