---
// Polices : seulement les jeux de caractères utiles (latin pour le français et l'anglais, arabe).
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isRtl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  image?: string;
  /** Chemins équivalents dans les autres langues, pour hreflang et le sélecteur */
  alternates?: Partial<Record<Lang, string>>;
  /** Données structurées schema.org (JSON-LD), un objet ou une liste d'objets. */
  jsonLd?: object | object[];
  /** `article` pour une fiche, `website` sinon. */
  ogType?: 'website' | 'article';
}

const { lang, title, description, image, alternates = {}, jsonLd, ogType = 'website' } = Astro.props;
const t = useTranslations(lang);
const siteName = t('site.name');
const fullTitle = title === siteName ? `${siteName} — ${t('site.tagline')}` : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Image de partage : celle de la fiche, sinon public/images/og-default.jpg (npm run icones).
const ogImage = new URL(image ?? '/images/og-default.jpg', Astro.site);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang} dir={isRtl(lang) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d3fa8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {Object.entries(alternates).map(([l, path]) => (
      <link rel="alternate" hreflang={l} href={new URL(path!, Astro.site)} />
    ))}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : lang === 'en' ? 'en_GB' : 'ar_TN'} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenu" class="sr-only z-50 rounded bg-accent px-4 py-2 font-semibold text-encre focus:not-sr-only focus:absolute focus:start-4 focus:top-4">{t('nav.contenu')}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="contenu" class="flex-1 focus:outline-none" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
